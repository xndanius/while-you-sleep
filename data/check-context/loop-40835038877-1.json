      "url": "https://community.n8n.io/t/325067",
      "productUrl": "https://community.n8n.io/t/325067",
      "title": "Workflow: daily alert for new jobs at target companies (Greenhouse/Lever/Ashby/Workday) to Slack",
      "text": "Workflow: Schedule Trigger (daily) → Apify node (“Run an Actor and get dataset”) → IF item count > 0 → Slack.",
      "community": "n8n community",
      "postedAt": "2026-10-28T06:32:56.020Z",
      "fetchedAt": "2026-10-29T07:25:27.611Z",
      "role": "demand",
      "demand": true,
      "demandMetadataVersion": 1,
      "discussionMetadataVersion": 1,
      "registrySourceId": "e935ee0506560f4175ecd570",
      "segment": "professional_services",
      "demandKind": "community_request",
      "taskExcerpts": [
        "Workflow: Schedule Trigger (daily) → Apify node (“Run an Actor and get dataset”) → IF item count > 0 → Slack."
